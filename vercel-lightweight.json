{
    "builds": [
        {
            "src": "api/index_lightweight.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index_lightweight.py"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index_lightweight.py"
        }
    ]
}